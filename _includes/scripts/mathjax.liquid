{% if site.enable_math and page.math != false %}
  {% if page.math
    or content contains 'math/tex'
    or content contains 'class="math'
    or content contains '<math'
    or content contains '\('
    or content contains '\['
    or content contains '\begin{'
    or content contains '$$'
  %}
    {% unless page.pseudocode %}
      <!-- MathJax -->
      <script type="text/javascript">
        window.MathJax = {
          tex: {
            tags: 'ams',
          },
        };
      </script>
      <script
        defer
        type="text/javascript"
        id="MathJax-script"
        src="{{ site.third_party_libraries.mathjax.url.js }}"
        integrity="{{ site.third_party_libraries.mathjax.integrity.js }}"
        crossorigin="anonymous"
      ></script>
      <script
        defer
        src="{{ site.third_party_libraries.polyfill.url.js }}"
        crossorigin="anonymous"
      ></script>
    {% endunless %}
  {% endif %}
{% endif %}
